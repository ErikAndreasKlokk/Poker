# --- Database ---
DATABASE_URL="postgres://user:password@host:5432/poker"

# --- adapter-node ---
# Required in production so SvelteKit can validate form POSTs behind the ingress.
ORIGIN="https://poker.erikak.no"

# --- Vipps Login (OIDC) ---
# Created per sales unit in portal.vipps.no. Use the test values against apitest.vipps.no
# until the integration is verified, then swap to api.vipps.no.
VIPPS_API_BASE="https://apitest.vipps.no"
VIPPS_CLIENT_ID=""
VIPPS_CLIENT_SECRET=""
VIPPS_SUBSCRIPTION_KEY=""
VIPPS_MERCHANT_SERIAL_NUMBER=""

# --- Invite-only registration ---
# Bootstrap code that creates the very first account. Rotate or remove after setup.
BOOTSTRAP_INVITE_CODE=""
