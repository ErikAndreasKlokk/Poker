# --- Database ---
DATABASE_URL="postgres://user:password@host:5432/poker"

# --- adapter-node ---
# Required in production so SvelteKit can validate form POSTs behind the ingress.
ORIGIN="https://poker.erikak.no"

# --- Invite-only registration ---
# Bootstrap code that creates the very first account. Rotate or remove after setup.
BOOTSTRAP_INVITE_CODE=""

# Note: there are no Vipps credentials here on purpose. The Vipps MobilePay APIs
# require a registered business, so the site never talks to Vipps. Boks codes are
# entered by hand per game and only ever rendered as a link and QR code.
